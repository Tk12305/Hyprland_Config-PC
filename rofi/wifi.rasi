* {
    bg0:     #0D0A1A;
    bg1:     #2A1A3E;
    bg2:     #4B2272;
    accent:  #F2833A;
    fg0:     #F0EAD6;
    fg1:     #9988BB;

    background-color: transparent;
    text-color:       @fg0;
    font:             "Nunito 13";
}

window {
    width:            500px;
    background-color: @bg0;
    border:           1px;
    border-color:     @accent;
    border-radius:    16px;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    padding:          16px;
    spacing:          8px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg1;
    border:           1px;
    border-color:     @accent;
    border-radius:    10px;
    padding:          8px 14px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search networks...";
    placeholder-color: @fg1;
    text-color:        @fg0;
}

listview {
    background-color: transparent;
    lines:            10;
    columns:          1;
    spacing:          3px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          10px;
    orientation:      horizontal;
    children:         [ element-text ];
}

element selected {
    background-color: @bg2;
    border:           1px;
    border-color:     @accent;
}

element-text {
    text-color:     @fg0;
    vertical-align: 0.5;
}
